{
  "schema_version": 1,
  "description": "Example safe recurring scheduler profile. Fill paths locally; this does not enable broker order submission.",
  "args": {
    "preset": "ongoing-no-submit",
    "output_dir": "path/to/pipeline_scheduler_runs",
    "journal_db": "path/to/committee_research_journal.db",
    "ledger_db": "path/to/paper_ledger.db",
    "action_plan": "path/to/account_action_plan.json",
    "profile_config": "ai_trader/trading_agent/longterm/configs/roth_ira_profile.json",
    "portfolio_news_monitor": false,
    "portfolio_news_snapshot_file": "path/to/portfolio_news_snapshot.json",
    "position_review_queue": false,
    "scheduler_handoff": "path/to/scheduler_handoff.json",
    "scheduler_review_bundle": false,
    "allow_existing_paper_positions": true,
    "expected_cash_from_portfolio_state": true,
    "max_runs": 1,
    "interval_seconds": 3600,
    "validate_config_only": true,
    "json": true
  }
}
